# Copie para .env (cp .env.example .env). O .env nunca vai para o Git.
# Com os valores abaixo o sistema sobe e responde sem nenhuma chave de API.

# --- Banco (só para desenvolvimento local; a porta fica presa em 127.0.0.1) ---
POSTGRES_USER=atende
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=atende
DB_PORT=5432

# --- Portas dos serviços na sua máquina ---
CORE_API_PORT=8000
MCP_SERVER_PORT=8001
