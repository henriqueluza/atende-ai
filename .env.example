# Copie para .env (cp .env.example .env). O .env nunca vai para o Git.
# Com os valores abaixo o sistema sobe e responde sem nenhuma chave de API.

# --- Banco (só para desenvolvimento local; a porta fica presa em 127.0.0.1) ---
POSTGRES_USER=atende
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=atende
DB_PORT=5432

# --- Portas dos serviços na sua máquina ---
CORE_API_PORT=8000
MCP_SERVER_PORT=8001

# --- Embeddings (core-api) ---
# "fake": determinístico, sem rede e sem chave (padrão; compara palavras em comum).
# "openai": qualquer serviço no formato da API de embeddings da OpenAI.
# Ao trocar de modelo, ajuste EMBEDDINGS_DIM e recrie o banco (docker compose down -v).
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_DIM=1024
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=
# EMBEDDINGS_API_KEY=

# --- Leitura de PDF e imagem (core-api) ---
# "tesseract": lê imagens e PDFs escaneados (a imagem Docker já traz o Tesseract com português).
# "nenhum": só PDF que já tem texto. Fora do Docker, "auto" usa o Tesseract se estiver instalado.
# OCR_PROVIDER=tesseract
# OCR_IDIOMA=por

# --- Busca (core-api) ---
# "hibrida" (padrão, embedding + palavras), "semantica" (só embedding) ou "palavras".
# BUSCA_MODO=hibrida
# Na híbrida, quanto vale o embedding, de 0 a 1. O resto são as palavras em comum.
# BUSCA_PESO_SEMANTICO=0.5

# --- Agente (roda na sua máquina, fora do Docker) ---
# "fake": responde com o trecho mais parecido, sem rede e sem chave (padrão).
# "anthropic": usa o Claude para redigir a resposta. Exige ANTHROPIC_API_KEY.
LLM_PROVIDER=fake
# LLM_MODEL=claude-opus-5-5
# Trechos com score abaixo disso são ignorados. Medido com a busca híbrida e o embedder falso.
# SCORE_MINIMO=0.2
# ANTHROPIC_API_KEY=
# CORE_API_URL=http://localhost:8000
# MCP_SERVER_URL=http://localhost:8001/mcp
