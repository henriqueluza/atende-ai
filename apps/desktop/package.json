{
  "name": "atende-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo de desktop do atende-ai para quem administra o acervo",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/garantir-electron.mjs && node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/garantir-electron.mjs && npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
